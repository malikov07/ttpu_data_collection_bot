# ─── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here
# Telegram IDs that are always admins in the bot (get yours from @userinfobot)
ADMIN_IDS=111111111

# ─── Storage ─────────────────────────────────────────────────────────────────
# PostgreSQL in production. If unset, a SQLite file in ./data is used (fine for testing).
# DATABASE_URL=postgresql+asyncpg://bot:password@localhost:5432/ttpu_bot

# ─── Staff website ───────────────────────────────────────────────────────────
# Public address of the panel. With docker compose it is https://$DOMAIN.
WEB_BASE_URL=http://localhost:8080
WEB_PORT=8080
SESSION_TTL_DAYS=7
# Used by docker compose: your domain (for HTTPS) and the database password
DOMAIN=ttpu.example.uz
POSTGRES_PASSWORD=change-me

# ─── EduPage ─────────────────────────────────────────────────────────────────
# Public timetable that admins import group names from ("Import from EduPage").
# Only the public timetable is read; nothing is sent to EduPage. Empty = off.
EDUPAGE_URL=https://ttpu.edupage.org

# ─── Backups ─────────────────────────────────────────────────────────────────
# Every day at BACKUP_TIME (in TIMEZONE) the database and website uploads are
# zipped into BACKUP_DIR (./backups with docker compose), kept BACKUP_KEEP_DAYS
# days, and sent by the bot to every admin. Admins can also send /backup.
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=30
# Encrypts the backups (AES-256 zip: open with 7-Zip, WinRAR or Keka).
# Strongly recommended: backups contain passport data. Store it in a password manager.
BACKUP_PASSWORD=

# ─── Defaults (admins can change these on the website) ───────────────────────
NOTIFY_LEADERS=true
MAX_DOCUMENT_PAGES=5
MIN_STUDENT_AGE=14
MAX_STUDENT_AGE=70
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
